    <owl:Ontology rdf:about="http://uish/ontology">
        <owl:imports rdf:resource="https://dataset-dl.liris.cnrs.fr/rdf-owl-urban-data-ontologies/Ontologies/CityGML/3.0/building"/>
        <owl:imports rdf:resource="https://dataset-dl.liris.cnrs.fr/rdf-owl-urban-data-ontologies/Ontologies/CityGML/3.0/core"/>
    </owl:Ontology>
    


