    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://uish/ontology#grossFloorArea -->

    <owl:DatatypeProperty rdf:about="http://uish/ontology#grossFloorArea">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uish/ontology#BuildingQuality"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
        <rdfs:label xml:lang="en">gross floor area</rdfs:label>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://uish/ontology#AcousticQuality -->

    <owl:Class rdf:about="http://uish/ontology#AcousticQuality">
        <rdfs:comment xml:lang="en">An quality of a building that determines its ability to control, transmit, absorb, or attenuate sound and vibration, thereby influencing acoustic performance and occupant comfort.</rdfs:comment>
        <rdfs:label xml:lang="en">Acoustic quality</rdfs:label>
        <skos:definition xml:lang="en">An quality of a building that determines its ability to control, transmit, absorb, or attenuate sound and vibration, thereby influencing acoustic performance and occupant comfort.</skos:definition>
    </owl:Class>
    


    <!-- http://uish/ontology#BuildingQuality -->

    <owl:Class rdf:about="http://uish/ontology#BuildingQuality">
        <rdfs:subClassOf rdf:resource="https://dataset-dl.liris.cnrs.fr/rdf-owl-urban-data-ontologies/Ontologies/CityGML/3.0/building#ADEOfBuilding"/>
        <rdfs:comment xml:lang="en">Describes one or more aspects of the performance and condition of a building.</rdfs:comment>
        <rdfs:label xml:lang="en">Building quality</rdfs:label>
        <skos:definition xml:lang="en">Describes one or more aspects of the performance and condition of a building.</skos:definition>
    </owl:Class>
    


    <!-- http://uish/ontology#ConstructionTimeSpan -->

    <owl:Class rdf:about="http://uish/ontology#ConstructionTimeSpan">
        <rdfs:comment xml:lang="en">Period in which the construction has been built</rdfs:comment>
        <rdfs:label xml:lang="en">Constructiontimespan</rdfs:label>
    </owl:Class>
    


    <!-- http://uish/ontology#DaylightAutonomy -->

    <owl:Class rdf:about="http://uish/ontology#DaylightAutonomy">
        <rdfs:label xml:lang="en">DaylightAutonomy</rdfs:label>
    </owl:Class>
    


    <!-- http://uish/ontology#EnergyInfo -->

    <owl:Class rdf:about="http://uish/ontology#EnergyInfo">
        <rdfs:label xml:lang="en">Energy information</rdfs:label>
    </owl:Class>
    


    <!-- http://uish/ontology#RefurbishmentScenario -->

    <owl:Class rdf:about="http://uish/ontology#RefurbishmentScenario">
        <rdfs:comment xml:lang="en">A planned or hypothetical refurbishment interventions applied to an existing buildingen, defined to evaluate or achieve specific functional, technical, economic, environmental, or performance objectives.</rdfs:comment>
        <rdfs:label xml:lang="en">Refurbishment scenario</rdfs:label>
        <skos:definition xml:lang="en">A planned or hypothetical refurbishment interventions applied to an existing buildingen, defined to evaluate or achieve specific functional, technical, economic, environmental, or performance objectives.</skos:definition>
    </owl:Class>
    


    <!-- http://uish/ontology#StructureTechnology -->

    <owl:Class rdf:about="http://uish/ontology#StructureTechnology">
        <rdfs:comment xml:lang="en">The construction technology to realize the load-bearing structure of a building.</rdfs:comment>
        <rdfs:label xml:lang="en">Structure technology</rdfs:label>
        <skos:definition xml:lang="en">The construction technology to realize the load-bearing structure of a building.</skos:definition>
    </owl:Class>
    


    <!-- http://uish/ontology#SunlightExposure -->

    <owl:Class rdf:about="http://uish/ontology#SunlightExposure">
        <rdfs:label xml:lang="en">SunlightExposure</rdfs:label>
    </owl:Class>
    


    <!-- http://uish/ontology#ThermalQuality -->

    <owl:Class rdf:about="http://uish/ontology#ThermalQuality">
        <rdfs:comment xml:lang="en">A quality that characterizes the thermal performance of a building.</rdfs:comment>
        <rdfs:label xml:lang="en">Thermal quality</rdfs:label>
        <skos:definition xml:lang="en">A quality that characterizes the thermal performance of a building.</skos:definition>
    </owl:Class>
    


    <!-- http://uish/ontology#VisualQuality -->

    <owl:Class rdf:about="http://uish/ontology#VisualQuality">
        <rdfs:comment xml:lang="en">A quality that characterizes the visual appearance and aesthetic performance of a building.</rdfs:comment>
        <rdfs:label xml:lang="en">Visual quality</rdfs:label>
        <skos:definition xml:lang="en">A quality that characterizes the visual appearance and aesthetic performance of a building.</skos:definition>
    </owl:Class>
    


    <!-- http://uish/ontology#WallSurfaceVisualQuality -->

    <owl:Class rdf:about="http://uish/ontology#WallSurfaceVisualQuality">
        <rdfs:label xml:lang="en">Wall surface visual quality</rdfs:label>
    </owl:Class>
</rdf:RDF>



