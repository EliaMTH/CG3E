    <!-- http://uish/ontology#acousticInfo -->

    <owl:ObjectProperty rdf:about="http://uish/ontology#acousticInfo">
        <rdfs:domain rdf:resource="http://uish/ontology#RefurbishmentScenario"/>
        <rdfs:label xml:lang="en">acoustic information</rdfs:label>
        <skos:definition xml:lang="en">Relates RefurbishmentScenario and AcusticInfo</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://uish/ontology#acousticQuality -->

    <owl:ObjectProperty rdf:about="http://uish/ontology#acousticQuality">
        <rdfs:domain rdf:resource="http://uish/ontology#BuildingQuality"/>
        <rdfs:range rdf:resource="http://uish/ontology#AcousticQuality"/>
        <rdfs:comment xml:lang="en">Relates a building to its acoustic quality</rdfs:comment>
        <rdfs:label xml:lang="en">acoustic quality</rdfs:label>
        <skos:definition xml:lang="en">Relates a building to its acoustic quality</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://uish/ontology#annualSunlightExposure -->

    <owl:ObjectProperty rdf:about="http://uish/ontology#annualSunlightExposure">
        <rdfs:domain rdf:resource="http://uish/ontology#WallSurfaceVisualQuality"/>
        <rdfs:range rdf:resource="http://uish/ontology#SunlightExposure"/>
        <rdfs:label xml:lang="en">annualSunlightExposure</rdfs:label>
        <skos:definition xml:lang="en">Relates WallSurfaceVisualQuality and SunlightExposure</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://uish/ontology#constructionTimeSpan -->

    <owl:ObjectProperty rdf:about="http://uish/ontology#constructionTimeSpan">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uish/ontology#BuildingQuality"/>
        <rdfs:range rdf:resource="http://uish/ontology#ConstructionTimeSpan"/>
    </owl:ObjectProperty>
    


    <!-- http://uish/ontology#daylightAutonomy -->

    <owl:ObjectProperty rdf:about="http://uish/ontology#daylightAutonomy">
        <terms:description xml:lang="en">daylightAutonomy</terms:description>
        <skos:definition xml:lang="en">Relates WallSurfaceVisualQuality and DaylightAutonomy</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://uish/ontology#elevatonStructureTechnology -->

    <owl:ObjectProperty rdf:about="http://uish/ontology#elevatonStructureTechnology">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://uish/ontology#BuildingQuality"/>
        <rdfs:range rdf:resource="http://uish/ontology#StructureTechnology"/>
        <rdfs:label xml:lang="en">elevation structure technology</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://uish/ontology#energyInfo -->

    <owl:ObjectProperty rdf:about="http://uish/ontology#energyInfo">
        <rdfs:domain rdf:resource="http://uish/ontology#RefurbishmentScenario"/>
        <rdfs:range rdf:resource="http://uish/ontology#EnergyInfo"/>
        <rdfs:comment xml:lang="en">Relates a refurbishment scenario to resulting energy information</rdfs:comment>
        <rdfs:label xml:lang="en">energy information</rdfs:label>
        <skos:definition xml:lang="en">Relates a refurbishment scenario to resulting energy information</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://uish/ontology#facade -->

    <owl:ObjectProperty rdf:about="http://uish/ontology#facade">
        <rdfs:domain rdf:resource="http://uish/ontology#VisualQuality"/>
        <rdfs:range rdf:resource="http://uish/ontology#WallSurfaceVisualQuality"/>
        <skos:definition xml:lang="en">Relates VisualQuality to WallSurfaceVisualQuality</skos:definition>
        <skos:definition xml:lang="en">facade</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://uish/ontology#refurbishmentScenario -->

    <owl:ObjectProperty rdf:about="http://uish/ontology#refurbishmentScenario">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://uish/ontology#BuildingQuality"/>
        <rdfs:range rdf:resource="http://uish/ontology#RefurbishmentScenario"/>
        <rdfs:comment xml:lang="en">Relates a building to a refurbishment scenario</rdfs:comment>
        <rdfs:label xml:lang="en">refurbishmentScenario</rdfs:label>
        <skos:definition xml:lang="en">Relates a building to a refurbishment scenario</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://uish/ontology#thermalQuality -->

    <owl:ObjectProperty rdf:about="http://uish/ontology#thermalQuality">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="http://uish/ontology#BuildingQuality"/>
        <rdfs:range rdf:resource="http://uish/ontology#ThermalQuality"/>
        <rdfs:comment xml:lang="en">Relates a building to its thermal quality</rdfs:comment>
        <rdfs:label xml:lang="en">thermal quality</rdfs:label>
        <skos:definition xml:lang="en">Relates a building to its thermal quality</skos:definition>
    </owl:ObjectProperty>
    


    <!-- http://uish/ontology#visualQuality -->

    <owl:ObjectProperty rdf:about="http://uish/ontology#visualQuality">
        <rdfs:domain rdf:resource="http://uish/ontology#BuildingQuality"/>
        <rdfs:range rdf:resource="http://uish/ontology#VisualQuality"/>
        <rdfs:comment xml:lang="en">Relates a Building to its visual quality</rdfs:comment>
        <rdfs:label xml:lang="en">visual quality</rdfs:label>
        <skos:definition xml:lang="en">Relates a Building to its visual quality</skos:definition>
    </owl:ObjectProperty>
    


