    <!-- http://www.uish.org/sensors/ssn/ext#AirQRHSensor -->

    <owl:Class rdf:about="http://www.uish.org/sensors/ssn/ext#AirQRHSensor">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.uish.org/sensors/ssn/ext#hasAccuracy"/>
                <owl:hasValue>5%</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.uish.org/sensors/ssn/ext#hasCode"/>
                <owl:hasValue>rh</owl:hasValue>
            </owl:Restriction>
        </owl:equivalentClass>
